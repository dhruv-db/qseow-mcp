# Qlik Sense site
QSEOW_HOST=sense.example.com          # hub/proxy hostname (no scheme)
QSEOW_QRS_PORT=4242                   # direct QRS (cert auth) — or use virtual proxy on 443
QSEOW_ENGINE_PORT=4747                # direct Engine (cert auth)

# Auth mode: certificate | header | jwt
QSEOW_AUTH_MODE=certificate

# certificate mode (paths to QMC-exported certs; NEVER commit these files)
QSEOW_CERT_PATH=./certs/client.pem
QSEOW_CERT_KEY_PATH=./certs/client_key.pem
QSEOW_ROOT_CERT_PATH=./certs/root.pem

# header / jwt modes
QSEOW_VIRTUAL_PROXY=                  # virtual proxy prefix, e.g. "hdr" or "jwt"
QSEOW_JWT=                            # signed JWT (jwt mode only)

# Identity the server acts as
QSEOW_USER_DIRECTORY=INTERNAL
QSEOW_USER_ID=sa_api

# Safety
QSEOW_ALLOW_MUTATIONS=false           # true enables write tools (reload, create, set-script, ...)
