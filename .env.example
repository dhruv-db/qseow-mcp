# ---------------------------------------------------------------------------
# qseow-mcp configuration. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Site ---
QSEOW_HOST=sense.example.com          # hostname (no scheme)
QSEOW_QRS_PORT=4242                   # QRS direct (certificate mode)
QSEOW_ENGINE_PORT=4747                # Engine direct (certificate mode)
QSEOW_PROXY_PORT=443                  # Proxy (jwt mode)

# --- Auth: certificate | jwt ---
# certificate: service-to-service via QMC-exported client certs on 4242/4747.
#              Full tool coverage (REST + engine). Recommended for servers.
# jwt:         via a JWT virtual proxy on 443. Signed, expiring, per-user —
#              preferred where an end-user identity must be carried.
#              NOTE: engine WebSocket through a virtual proxy is subject to
#              Qlik's CSWSH protection; see README "JWT and the engine".
QSEOW_AUTH_MODE=certificate

# certificate mode (paths to QMC-exported PEM certs; never commit these files)
QSEOW_CERT_PATH=./certs/client.pem
QSEOW_CERT_KEY_PATH=./certs/client_key.pem
QSEOW_ROOT_CERT_PATH=./certs/root.pem
QSEOW_CERT_PASSPHRASE=
# Identity asserted on QRS calls in certificate mode
QSEOW_CERT_USER_DIRECTORY=INTERNAL
QSEOW_CERT_USER_ID=sa_repository

# jwt mode — supply the token directly or a file containing it
QSEOW_VP_PREFIX=jwt
QSEOW_JWT=
QSEOW_JWT_PATH=

# --- Safety ---
# Which persona tool groups to expose: analyst, developer, admin (comma-separated)
QSEOW_TOOL_GROUPS=analyst,developer,admin
# Write tools (reload, set_script, create/copy/publish app, start_task) are
# refused unless this is true. Default read-only.
QSEOW_ALLOW_MUTATIONS=false
# Set false ONLY for self-signed lab certs
QSEOW_TLS_VERIFY=true
